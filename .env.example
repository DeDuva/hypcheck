# --- Research engine ---------------------------------------------------------
# With a key set, scheduled/manual runs perform live web research via the
# Claude API. Without it, runs use the deterministic simulated engine
# (every run is labeled "Simulated" vs "Live" in the UI).
ANTHROPIC_API_KEY=
# Model used for research runs and hypothesis refinement. Defaults to
# claude-sonnet-4-6 (fast enough to keep a full run under a 300s function
# limit). Set to claude-opus-4-8 for maximum depth if your runtime allows it.
HYPCHECK_MODEL=claude-sonnet-4-6
# Abort the live research call after this many ms so a runaway run falls back to
# a recorded result instead of hanging. Research runs on GitHub Actions (see
# "Research runner" below), not in a Vercel function, so 600 s is fine.
HYPCHECK_RESEARCH_ABORT_MS=600000

# --- Access control ----------------------------------------------------------
# Sign-in is Google OAuth via Better Auth. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
#   <your-domain>/api/auth/callback/google
# Local dev WITHOUT these set runs open (no sign-in wall). Production without
# them is locked — nobody can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Invite list: comma-separated emails allowed to sign in (case-insensitive).
# Checked at signup and on every request, so removing an email revokes access.
# Empty in production means nobody can sign up.
ALLOWED_EMAILS=
# Session-cookie signing secret; required in production (openssl rand -hex 32).
BETTER_AUTH_SECRET=
# Canonical app URL for OAuth redirects. On Vercel this defaults to the
# production domain (VERCEL_PROJECT_PRODUCTION_URL); set it explicitly for a
# custom domain.
# BETTER_AUTH_URL=https://hypcheck.example.com

# --- Database ----------------------------------------------------------------
# Local dev defaults to file:./data/hypcheck.db (no config needed).
# For Vercel, point at a Turso database:
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# --- Scheduled runs ----------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron.
CRON_SECRET=

# --- Research runner ---------------------------------------------------------
# A research run outlasts Vercel Hobby's 300 s function limit, so the app never
# runs one itself: /api/cron and "Run now" dispatch the research.yml GitHub
# Actions workflow, which runs scripts/research.ts against Turso. The workflow
# reads ANTHROPIC_API_KEY / TURSO_DATABASE_URL / TURSO_AUTH_TOKEN from the
# repo's Actions secrets. On Vercel, set (Production scope only):
#   fine-grained PAT, repository DeDuva/hypcheck only, permission Actions: write
# HYPCHECK_DISPATCH_TOKEN=
# HYPCHECK_DISPATCH_REPO=DeDuva/hypcheck
# HYPCHECK_DISPATCH_REF=main
# Locally, run the job directly instead:
#   npx tsx --env-file=.env.local scripts/research.ts --local

# Demo seed data on an empty database: on by default in dev (set "0" to
# disable). In production it's opt-in — set "1" explicitly, otherwise a live
# deployment never auto-creates hypchecks (which cron would then run on a
# cadence, spending API credits).
HYPCHECK_DEMO=1

# --- Observability -----------------------------------------------------------
# Log verbosity: debug | info | warn | error. Defaults to info in production,
# debug in dev. Logs are structured JSON in production (Vercel log drain).
# HYPCHECK_LOG_LEVEL=info
# Debug/health snapshot (engine mode, DB connectivity, counts, last-run
# telemetry) is served at GET /api/health.
