# --- Research engine ---------------------------------------------------------
# With a key set, scheduled/manual runs perform live web research via the
# Claude API. Without it, runs use the deterministic simulated engine
# (every run is labeled "Simulated" vs "Live" in the UI).
ANTHROPIC_API_KEY=
# Model used for research runs and hypothesis refinement.
HYPCHECK_MODEL=claude-opus-4-8

# --- Database ----------------------------------------------------------------
# Local dev defaults to file:./data/hypcheck.db (no config needed).
# For Vercel, point at a Turso database:
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# --- Scheduled runs ----------------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron.
CRON_SECRET=

# Set to "0" to disable demo seed data on an empty database.
HYPCHECK_DEMO=1

# --- Observability -----------------------------------------------------------
# Log verbosity: debug | info | warn | error. Defaults to info in production,
# debug in dev. Logs are structured JSON in production (Vercel log drain).
# HYPCHECK_LOG_LEVEL=info
# Debug/health snapshot (engine mode, DB connectivity, counts, last-run
# telemetry) is served at GET /api/health.
